<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dashboard_root_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:background="#00000000">

    <!-- Top Dashboard Header with Live Pulse Indicator -->
    <LinearLayout
        android:id="@+id/dashboard_header_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="#00000000"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/dashboard_dot_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● LIVE"
            android:textColor="#00FF66"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/dashboard_title_tv"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="  SYS_KERNEL_MATRIX"
            android:textColor="#00FF66"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/dashboard_time_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00:00"
            android:textColor="#00FFFF"
            android:textSize="11sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- Dynamic Grid Container for customizable NxM grid boxes (1x1 to 5x5) -->
    <GridLayout
        android:id="@+id/dashboard_grid_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alignmentMode="alignMargins"
        android:columnCount="2"
        android:useDefaultMargins="false" />

    <!-- Hidden compatibility text views for legacy T-UI indexing -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView android:id="@+id/tv0" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/tv1" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/tv2" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/tv3" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/tv4" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/tv5" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/tv6" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/tv7" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/tv8" android:layout_width="match_parent" android:layout_height="wrap_content" />
    </LinearLayout>

</LinearLayout>